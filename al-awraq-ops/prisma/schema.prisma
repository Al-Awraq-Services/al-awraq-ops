// Al Awraq Services — Instant Invoicing App
//
// Pivot (2026-09-29): this schema replaces the earlier multi-role CRM
// prototype (User/Session/Role/AuditLog/Lead/Service/Quote) entirely, per
// the business owner's direct request for a single-user, no-accounts,
// no-catalog instant-invoicing tool. See docs/CHANGE_LOG.md for the full
// pivot entry and docs/HANDOVER_LOG.md for the reasoning.
//
// Four models only:
// - BusinessProfile: one singleton row — company details, branding, the
//   single app password, and the running invoice-number counter.
// - Customer: a lightweight address book for autocomplete + balance
//   history. Not an account — customers never sign in.
// - Invoice / InvoiceItem: the actual product. No stored totals anywhere
//   (subtotal/tax/total/balance are always computed live — see
//   src/lib/invoiceMath.ts) so a number can never drift out of sync with
//   its line items.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Singleton settings row (fixed id "singleton" — always look it up by that
/// id, never findFirst). Pre-seeded from the real values on the owner's
/// existing invoice template (prisma/seed.ts) so Settings isn't blank on
/// first run.
model BusinessProfile {
  id     String @id @default("singleton")

  legalName String  @default("AL AWRAQ TECHNICAL SERVICES EST.")
  trn       String?
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String? @default("/logo.jpg")

  /// Default VAT % applied to new invoices (still editable per invoice).
  defaultTaxRatePercent Decimal @default(5) @db.Decimal(5, 2)

  /// The number the *next* created invoice will use, then incremented.
  /// Editable in Settings so the owner can continue his real sequence
  /// (e.g. his last paper/software invoice was 01063) instead of
  /// restarting at 1.
  nextInvoiceNumber   Int    @default(1064)
  invoiceNumberPrefix String @default("")
  /// Zero-padded width, e.g. 5 -> "01064". Matches the sample invoice.
  invoiceNumberPadding Int   @default(5)

  /// B2B pass (2026-10-01): same numbering pattern as Invoice, for Inquiry.
  nextInquiryNumber   Int    @default(1)
  inquiryNumberPrefix String @default("INQ-")
  inquiryNumberPadding Int   @default(5)

  /// Same pattern again, for PurchaseOrder (the buying side).
  nextPoNumber   Int    @default(1)
  poNumberPrefix String @default("PO-")
  poNumberPadding Int   @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_profile")
}

/// Multi-account pass (2026-10-01): replaces the single shared app
/// password with real per-account logins. Exactly one row ever has
/// `isMainAccount: true` — created by the seed script, never by the Users
/// screen — and that flag is the one hard-coded rule in this app that is
/// NOT a togglable permission: only the main account ever sees the
/// Dashboard or any aggregate money figure (see src/lib/auth/appAuth.ts
/// `requireMainAccount` and the money-hiding checks scattered through the
/// invoices/customers pages). The four `can…` flags below are the
/// per-section view/manage toggles the main account sets when creating or
/// editing any other account (src/app/(app)/users) — the main account
/// itself bypasses these checks entirely rather than needing them true.
model User {
  id           String  @id @default(cuid())
  name         String
  /// Login handle — not an email, no email flows exist in this app.
  username     String  @unique
  passwordHash String
  isMainAccount Boolean @default(false)

  canViewInvoices    Boolean @default(false)
  canManageInvoices  Boolean @default(false)
  canViewCustomers   Boolean @default(false)
  canManageCustomers Boolean @default(false)

  /// B2B pass (2026-10-01): Inquiry mirrors Invoice's permission pair
  /// exactly. Purchase Order's pair also covers Vendor management — unlike
  /// Customer (which has its own pair alongside Invoice), Vendor
  /// deliberately does not get its own flags, to keep this list from
  /// growing without bound; see docs/CHANGE_LOG.md for the reasoning.
  canViewInquiries        Boolean @default(false)
  canManageInquiries      Boolean @default(false)
  canViewPurchaseOrders   Boolean @default(false)
  canManagePurchaseOrders Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// A lightweight address book — not an account, never signs in. Exists
/// purely so the invoice form can offer name/address/contact autocomplete
/// and so a customer's running balance across past invoices can be shown.
///
/// B2B pass (2026-10-01): extended with business fields rather than
/// building a separate Company entity — one address book serves both
/// Invoice (B2C) and Inquiry (B2B); `type` just determines which extra
/// fields are relevant. All four additions are nullable/defaulted, so
/// existing Invoice code (which only ever reads name/address/contact)
/// needed no changes.
model Customer {
  id      String       @id @default(cuid())
  name    String
  address String?
  contact String?
  email   String?
  notes   String?
  type    CustomerType @default(INDIVIDUAL)

  /// Relevant when type is BUSINESS — shown on an Inquiry's billing block
  /// and its PDF (UAE B2B VAT invoices conventionally print the buyer's
  /// TRN alongside the seller's).
  companyName   String?
  businessTrn   String?
  contactPerson String?

  invoices  Invoice[]
  inquiries Inquiry[]
  createdAt DateTime  @default(now())

  @@index([name])
  @@map("customers")
}

/// One generated invoice. Billing details are **snapshotted** at creation
/// time (billingName/billingAddress/billingContact) rather than read live
/// from Customer, so editing a saved customer later never rewrites a past
/// invoice's history — the same pattern the prior schema used well for
/// InvoiceItem snapshots.
///
/// No stored subtotal/tax/total/balance anywhere on this model — all of it
/// is computed on read from `items` + the adjustment fields below, via
/// src/lib/invoiceMath.ts, so it can never drift out of sync with edits.
model Invoice {
  id            String   @id @default(cuid())
  /// Human-entered/edited display number, e.g. "01064". Independent of
  /// `id` — this is what appears on the printed invoice and is freely
  /// editable, matching the pencil-edit affordance on the reference form.
  invoiceNumber String   @unique
  invoiceDate   DateTime @default(now())
  dueDate       DateTime?

  poNumber     String?
  /// Free text, not an enum — deliberately not a dropdown (a <datalist>
  /// in the UI offers common values as suggestions only).
  paymentMethod String?
  salesperson   String?

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  billingName    String
  billingAddress String?
  billingContact String?

  /// Defaults to the exact footer line used on the sample invoice.
  notes String? @default("This is a VAT invoice.")

  taxRatePercent   Decimal  @default(5) @db.Decimal(5, 2)
  /// Invoice-level adjustments — the "Discount"/"Shipment"/"Stamp Duty"
  /// buttons on the reference creation screen. Distinct from a line
  /// item's own `retentionAmount` (see InvoiceItem).
  discountAmount   Decimal? @db.Decimal(10, 2)
  shipmentAmount   Decimal? @db.Decimal(10, 2)
  stampDutyAmount  Decimal? @db.Decimal(10, 2)
  /// How much has actually been paid so far. Status (Unpaid/Partial/Paid)
  /// and the remaining balance are both derived from this, never stored.
  amountPaid       Decimal  @default(0) @db.Decimal(10, 2)

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([invoiceDate])
  @@map("invoices")
}

/// One priced line on an invoice. `description` is always free text — the
/// prior schema's Service catalog is gone entirely; there is no dropdown
/// of predefined services to pick from, per the owner's explicit request.
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  /// Decimal, not Int — "2.5 hrs" is a valid quantity.
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  /// Free text unit label ("pcs", "hrs", ...) — blank is valid, matching
  /// the sample invoice's blank "Units" column.
  unit        String?
  unitPrice   Decimal @db.Decimal(10, 2)
  /// Matches the "Retention" column on the real invoice template exactly
  /// (distinct from Invoice.discountAmount — see the Invoice model doc).
  retentionAmount Decimal? @db.Decimal(10, 2)

  /// Explicit ordering — line order matters on the printed invoice and
  /// isn't reliably reconstructable from createdAt alone once lines are
  /// edited.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// --- B2B pass (2026-10-01): Inquiry, Purchase Order, Accounting ---
// Inquiry/InquiryItem are structurally identical to Invoice/InvoiceItem —
// see those models' comments for the "no stored totals, snapshot billing
// details" reasoning, which applies here unchanged. Vendor/PurchaseOrder/
// PurchaseOrderItem are the buying-side mirror. Expense is deliberately
// minimal — see its own comment below.

/// B2B counterpart to Invoice — same mechanics, billed to a business
/// instead of an individual. Own numbered series (BusinessProfile
/// nextInquiryNumber/inquiryNumberPrefix/inquiryNumberPadding).
model Inquiry {
  id            String   @id @default(cuid())
  inquiryNumber String   @unique
  inquiryDate   DateTime @default(now())
  dueDate       DateTime?

  poNumber      String?
  paymentMethod String?
  salesperson   String?

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  billingName    String
  billingAddress String?
  billingContact String?
  /// Snapshotted the same way as billingName/Address/Contact — a later
  /// edit to the Customer record never rewrites a past Inquiry's PDF.
  billingCompanyName String?
  billingBusinessTrn String?

  notes String? @default("This is a VAT invoice.")

  taxRatePercent  Decimal  @default(5) @db.Decimal(5, 2)
  discountAmount  Decimal? @db.Decimal(10, 2)
  shipmentAmount  Decimal? @db.Decimal(10, 2)
  stampDutyAmount Decimal? @db.Decimal(10, 2)
  amountPaid      Decimal  @default(0) @db.Decimal(10, 2)

  items InquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([inquiryDate])
  @@map("inquiries")
}

model InquiryItem {
  id        String  @id @default(cuid())
  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  description     String
  quantity        Decimal  @default(1) @db.Decimal(10, 2)
  unit            String?
  unitPrice       Decimal  @db.Decimal(10, 2)
  retentionAmount Decimal? @db.Decimal(10, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_items")
}

/// The buying-side mirror of Customer — who Purchase Orders go to. Not an
/// account, never signs in.
model Vendor {
  id      String  @id @default(cuid())
  name    String
  address String?
  contact String?
  email   String?
  notes   String?

  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())

  @@index([name])
  @@map("vendors")
}

/// An order placed with a vendor — the mirror image of Invoice (money
/// going out instead of coming in). Same no-stored-totals /
/// snapshotted-billing-details pattern. No retentionAmount on its line
/// items (not a buying-side concept) and no stampDutyAmount at the
/// document level. Own numbered series (BusinessProfile
/// nextPoNumber/poNumberPrefix/poNumberPadding).
model PurchaseOrder {
  id       String    @id @default(cuid())
  poNumber String    @unique
  orderDate    DateTime  @default(now())
  expectedDate DateTime?

  vendorId            String
  vendor              Vendor  @relation(fields: [vendorId], references: [id])
  billingVendorName    String
  billingVendorAddress String?
  billingVendorContact String?

  notes String?

  taxRatePercent Decimal  @default(5) @db.Decimal(5, 2)
  discountAmount Decimal? @db.Decimal(10, 2)
  shipmentAmount Decimal? @db.Decimal(10, 2)
  /// How much of this PO has actually been paid to the vendor — this is
  /// the number the Accounting Machine's cash-basis cost total reads
  /// (src/app/(app)/accounting), not the PO's full amount.
  amountPaid     Decimal  @default(0) @db.Decimal(10, 2)

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @db.Decimal(10, 2)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

/// A general business cost not tied to a specific Purchase Order (rent,
/// salaries, fuel, utilities...). Deliberately minimal — no line items, no
/// vendor link, no payment-status tracking (an expense is recorded as
/// already paid, on `date`). Entry happens directly inside the
/// main-account-only Accounting page, not a separately permission-gated
/// section — see the User model comment for why it has no canView/
/// canManage pair of its own.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  /// Free text, not an enum — a <datalist> in the UI suggests common
  /// values (Rent, Utilities, Salaries, Fuel, Supplies, Maintenance,
  /// Other) without forcing a fixed list, same philosophy as
  /// Invoice.paymentMethod.
  category    String
  description String?
  amount      Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([date])
  @@map("expenses")
}
