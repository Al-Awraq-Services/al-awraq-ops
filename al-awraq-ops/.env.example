# Al Awraq Services — Instant Invoicing App
# Copy this file to .env and fill in real values for YOUR local machine.
# .env is git-ignored (see .gitignore) — never commit real values.
# This file must never contain real secrets. Names only.

# PostgreSQL connection string for your database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example shape only — do not copy these example values as real credentials:
#   postgresql://postgres:postgres@localhost:5432/al_awraq_ops
DATABASE_URL=

# development | production | test — Next.js sets this automatically for
# `next dev` / `next build`; you do not need to set it by hand for local work.
NODE_ENV=

# Long random string used to sign the single-password app-session cookie
# (see src/lib/auth/sessionToken.ts). There is no Session table — this
# secret is the only thing that makes a session cookie valid, so treat it
# like a password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value instantly logs every device out.
APP_SESSION_SECRET=
