# Al Awraq Services — Internal Ops Prototype
# Copy this file to .env and fill in real values for YOUR local machine.
# .env is git-ignored (see .gitignore) — never commit real values.
# This file must never contain real secrets. Names only.

# --- Phase A ---

# PostgreSQL connection string for your local database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example shape only — do not copy these example values as real credentials:
#   postgresql://postgres:postgres@localhost:5432/al_awraq_ops
DATABASE_URL=

# development | production | test — Next.js sets this automatically for
# `next dev` / `next build`; you do not need to set it by hand for local work.
NODE_ENV=

# --- Phase B ---

# Used once, by `npm run db:seed`, to create the first Admin account.
# Not read anywhere else in the app after that.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

# NOTE: a SESSION_SECRET variable was originally reserved here in Phase A,
# assuming signed session cookies (the common pattern). The Phase B
# implementation uses DB-backed opaque session tokens instead (looked up by
# hash, per docs/SECURITY_BASELINE.md) — nothing is cryptographically
# signed, so no session secret is needed. Removed rather than left as an
# unused, confusing variable. See docs/HANDOVER_LOG.md Phase B entry.

# --- Reserved for later phases (do not fill in yet) ---

# Phase E — local directory used for uploaded job files during the
# prototype (local disk storage only, never a public path).
FILE_STORAGE_PATH=
